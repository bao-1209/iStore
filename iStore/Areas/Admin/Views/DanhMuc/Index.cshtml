@model List<iStore.Models.DanhMuc>

@{
    ViewBag.Title = "Danh sách danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Danh sách danh mục</h2>
            <a class="btn btn-sm btn-success" href="@Url.Action("taoDanhMuc", "DanhMuc", new { area = "Admin" })">Thêm danh mục</a>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <table class="table table-hover table-bordered shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên danh mục</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id_danhmuc</td>
                                <td>@item.ten_danhmuc</td>
                                <td class="text-center">
                                    <a class="btn btn-warning btn-sm" href="@Url.Action("suaDanhMuc", "DanhMuc", new { id = item.id_danhmuc })" title="Sửa">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm" href="@Url.Action("xoaDanhMuc", "DanhMuc", new { id = item.id_danhmuc })" title="Xóa" onclick="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-danger">Không có danh mục nào. Vui lòng thêm danh mục.</p>
            }
        </div>
    </div>
</div>
