@{
    ViewBag.Title = "_ProductsLayout";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Navbar -->
<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom mb-4">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-primary" href="@Url.Action("Index", "SanPham", new { area = "Admin" })">Quản lý sản phẩm</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "SanPham" ? "active fw-bold" : "")" aria-current="page" href="@Url.Action("Index","SanPham", new {area = "Admin"})">Sản phẩm</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "ThuongHieu" ? "active fw-bold" : "")" href="@Url.Action("Index","ThuongHieu", new {area = "Admin"})">Thương hiệu</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"].ToString() == "CauHinh" ? "active fw-bold" : "")" href="@Url.Action("Index","CauHinh", new {area = "Admin"})">Cấu hình</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

@RenderBody()
<!-- Nội dung chính -->
