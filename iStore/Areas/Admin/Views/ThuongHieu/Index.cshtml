@model List<iStore.Models.ThuongHieu>

@{
    ViewBag.Title = "Danh sách thương hiệu";
    Layout = "~/Areas/Admin/Views/Shared/_ProductsLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Danh sách thương hiệu</h2>
            <a class="btn btn-sm btn-success" href="@Url.Action("Tao", "ThuongHieu", new { area = "Admin" })">Thêm thương hiệu</a>
        </div>

        <div class="card-body">
            @if (Model != null && Model.Count > 0)
            {
                <form class="d-flex flex-row align-items-center flex-wrap mb-4" method="get">
                    <label for="search" class="mx-2 my-1">Tìm kiếm:</label>
                    <input type="search" class="form-control w-auto" id="search" name="search" value="@Request.QueryString["search"]" placeholder="Nhập tên thương hiệu..." />
                    <button type="submit" class="btn btn-primary mx-2">
                        <i class="lni lni-search-alt"></i> Tìm kiếm
                    </button>
                </form>

                <table class="table table-hover table-bordered shadow-sm">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên thương hiệu</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id_thuonghieu</td>
                                <td>@item.ten_thuonghieu</td>
                                <td class="text-center">
                                    <a class="btn btn-warning btn-sm" href="@Url.Action("Sua", "ThuongHieu", new { id = item.id_thuonghieu })" title="Sửa">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm" href="@Url.Action("Xoa", "ThuongHieu", new { id = item.id_thuonghieu })" onclick="return confirm('Bạn có chắc muốn xóa thương hiệu này?');" title="Xóa">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-danger">Không có thương hiệu nào. Vui lòng thêm thương hiệu.</p>
            }
        </div>
    </div>
</div>
